# ==================================================
# Nook Café Monorepo .gitignore
# Angular Frontend + Spring Boot Backend
# ==================================================


# ==================================================
# Frontend - Angular
# ==================================================

# Dependencies
nook-cafe-fe/node_modules/

# Angular build output
nook-cafe-fe/dist/
nook-cafe-fe/tmp/
nook-cafe-fe/out-tsc/
nook-cafe-fe/bazel-out/

# Angular cache
nook-cafe-fe/.angular/cache/


# npm logs
nook-cafe-fe/npm-debug.log*
nook-cafe-fe/yarn-error.log*


# Coverage
nook-cafe-fe/coverage/


# Angular / Sass cache
nook-cafe-fe/.sass-cache/


# Test files output
nook-cafe-fe/testem.log
nook-cafe-fe/__screenshots__/


# ==================================================
# Backend - Spring Boot / Maven
# ==================================================

# Maven build
nook-cafe-be/target/

# Maven wrapper generated files
.nvm/
*.log


# Spring Boot logs
nook-cafe-be/*.log


# ==================================================
# Java
# ==================================================

*.class
*.jar
*.war
*.ear


# ==================================================
# IDEs and Editors
# ==================================================

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr


# Eclipse
.classpath
.project
.settings/


# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json


# Sublime
*.sublime-workspace
*.sublime-project


# Other IDE
.c9/
*.launch


# ==================================================
# Operating System
# ==================================================

.DS_Store
Thumbs.db


# ==================================================
# Environment / Secrets
# ==================================================

.env
.env.*
!.env.example


# ==================================================
# Temporary files
# ==================================================

*.tmp
*.temp
*.swp
*.swo
*~


